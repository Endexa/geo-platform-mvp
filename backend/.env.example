# Database (Supabase PostgreSQL — get URL from Supabase dashboard > Settings > Database)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase (dashboard > Settings > API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# AI/LLM (Required for AI engine dispatch and recommendations)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITYAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# Redis (local Docker container for caching + Celery broker)
REDIS_URL=redis://localhost:6379/0

# Stripe (Optional)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Jira (Optional)
JIRA_BASE_URL=https://placeholder.atlassian.net
JIRA_EMAIL=placeholder@domain.com
JIRA_API_TOKEN=placeholder-token

# App Security Settings
SECRET_KEY=CHANGE-ME-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Policy
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGITS=true
PASSWORD_REQUIRE_SPECIAL=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FREE_TIER=3
RATE_LIMIT_PRO_TIER=100
RATE_LIMIT_ENTERPRISE_TIER=1000
RATE_LIMIT_WINDOW=60

# Request Limits
MAX_REQUEST_SIZE=10485760
MAX_UPLOAD_SIZE=10485760

# Security Headers
ENABLE_SECURITY_HEADERS=true
ENABLE_CSRF_PROTECTION=false
ENABLE_AUDIT_LOGGING=true
ENABLE_RATE_LIMITING=true

# CORS (Frontend URL)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
