# API Configuration
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# Supabase (dashboard > Settings > API)
NUXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=your-anon-key

# ========== Stripe (publishable key only — NEVER use secret key in frontend) ==========
# Get from Stripe Dashboard > Developers > API keys > Publishable key
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Get from Stripe Dashboard > Products > your Pro product > Prices > copy price ID
NUXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=price_...
