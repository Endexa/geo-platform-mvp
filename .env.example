# GEO Platform MVP - Environment Variables
# Copy this file to .env and fill in your actual values

# ========== MongoDB Configuration ==========
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGO_DB_NAME=geo_platform

# ========== Qdrant Vector Database ==========
QDRANT_URL=https://your-cluster.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# ========== OpenAI API (for embeddings) ==========
OPENAI_API_KEY=sk-your_openai_api_key_here

# ========== PostgreSQL (legacy, optional) ==========
GEO_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/geo_platform

# ========== External APIs (optional) ==========
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
AHREFS_API_KEY=your_ahrefs_key_here
SEMRUSH_API_KEY=your_semrush_key_here
GOOGLE_PAGESPEED_API_KEY=your_google_pagespeed_key_here

# ========== Application Settings ==========
GEO_REQUEST_TIMEOUT=10
GEO_MAX_RETRIES=3
GEO_ENABLE_EXTERNAL_APIS=false
GEO_PARALLEL_EXECUTION=true
GEO_MAX_WORKERS=4

# ========== Embedding Settings ==========
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
QDRANT_COLLECTION_NAME=geo_documents
