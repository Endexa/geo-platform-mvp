# GEO Platform MVP - Environment Variables
# Copy this file to .env and fill in your actual values

# ========== Core Database ==========
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/geo_platform

# ========== Redis (cache + Celery broker) ==========
REDIS_URL=redis://localhost:6379/0

# ========== OpenAI API (embeddings + recommendations) ==========
OPENAI_API_KEY=sk-your_openai_api_key_here

# ========== Supabase (auth + hosted DB) ==========
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here

# ========== External APIs (optional — for GEO data points) ==========
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
AHREFS_API_KEY=your_ahrefs_key_here
SEMRUSH_API_KEY=your_semrush_key_here
GOOGLE_PAGESPEED_API_KEY=your_google_pagespeed_key_here

# ========== Integrations (optional) ==========
STRIPE_SECRET_KEY=your_stripe_secret_key_here
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_API_TOKEN=your_jira_api_token_here

# ========== Application Settings ==========
SECRET_KEY=your-secret-key-here
GEO_REQUEST_TIMEOUT=10
GEO_MAX_RETRIES=3
GEO_ENABLE_EXTERNAL_APIS=false
GEO_PARALLEL_EXECUTION=true
GEO_MAX_WORKERS=4

# ========== Embedding Settings (for Brand Signature) ==========
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
